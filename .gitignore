.direnv/

# nix-direnv's shell cache: a local artefact with absolute /nix/store paths.
# Committing it pins one machine's store hashes into the repo.
.direnv/

# Android (regenerated by capacitor + gradle).
#
# The whole platform is generated by `pnpm exec cap add android`, so the entire
# directory is ignored rather than tracked: 50 files of Gradle wrapper, splash
# screens and launcher icons that `cap sync` would rewrite anyway.
#
# The one hand-edited file inside it (release signing) cannot simply be
# re-included — git does not descend into an excluded directory, and re-including
# it precisely (with `!/android/app/build.gradle`) means every intermediate
# directory needs its own negation, which then drags the whole subtree back in.
# So the signing configuration lives in scripts/android/ instead and is applied by
# `just android-sign-setup`. Losing a regenerated file costs one command; a
# gitignore rule nobody dares touch costs more.
/android/
android-sdk/
*.apk
*.aab
*.jks
*.keystore

# Local dev backend (generated music library + navidrome data)
testdata/
devdata/

